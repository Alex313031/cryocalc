// Embed manifest for common controls and DPI support
#ifdef __MINGW32__
APP_MANIFEST RT_MANIFEST "cryocalc.manifest"
#endif // __MINGW32__

// Application Icons
// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_CRYOCALC   ICON  "res/cryocalc.ico"
IDI_SMALL      ICON  "res/small.ico"
IDI_WINFLAG    ICON  "res/winflag.ico"
IDI_WPERF      ICON  "res/cpuslice.ico"

#ifdef APSTUDIO_INVOKED

1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#ifndef APSTUDIO_INVOKED\r\n"
    "#include ""version.h""\r\n"
    "#endif\r\n"
    "#define APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "#include ""windows.h""\r\n"
    "#undef APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "#include ""winres.h""\r\n"
    "\0"
END

#endif // APSTUDIO_INVOKED

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL

STRINGTABLE
BEGIN
   IDC_CRYOCALC CRYOCALC_MAIN_WNDCLASS
END

// Main Application Menu
IDC_CRYOCALC MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Run",     IDM_RUN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",    IDM_CEXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Cut",     IDM_CUT, GRAYED
        MENUITEM "&Copy",    IDM_COPY, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Paste",   IDM_PASTE
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Disable Console",       IDM_DISABLE_CON, GRAYED
        POPUP "&Update Speed"
        BEGIN
            MENUITEM "&Low (2.0 sec.)",    IDM_SPEED_LOW
            MENUITEM "&Medium (1.0 sec.)", IDM_SPEED_MED
            MENUITEM "&High (0.5 sec.)",   IDM_SPEED_HIGH
        END
    END
    POPUP "&Dev"
    BEGIN
        MENUITEM "&System Monitor", IDM_SYSMON
        MENUITEM "&Open Log File",  IDM_OPEN_LOG
        MENUITEM SEPARATOR
        POPUP "&More"
        BEGIN
            MENUITEM "&Attach Console", IDM_ATTACH_CON
            MENUITEM "&Detach Console", IDM_DETACH_CON
            MENUITEM "&Clear Console",  IDM_CLEAR_CON
            MENUITEM "Clear &Log File", IDM_CLEAR_LOG
            MENUITEM "&Test Logging",   IDM_TEST_LOG
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help",    IDM_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About",   IDM_ABOUT
    END
    POPUP "?" HELP
    BEGIN
        MENUITEM "&Help",    IDM_HELPEX
    END
END

// System Monitor window menu
IDC_WPERF MENU
BEGIN
  POPUP "&Settings"
  BEGIN
    POPUP "&Update Speed"
    BEGIN
      MENUITEM "&Low (2.0 sec.)",    IDM_SPEED_LOW
      MENUITEM "&Medium (1.0 sec.)", IDM_SPEED_MED
      MENUITEM "&High (0.5 sec.)",   IDM_SPEED_HIGH
    END
    MENUITEM SEPARATOR
    MENUITEM "&Fill Graph Lines",  IDM_FILL_LINES
    MENUITEM "Show &Kernel Times", IDM_SHOW_KERNEL
    MENUITEM "&Close",             IDM_CLOSE_MON
  END
  POPUP "&About"
  BEGIN
    MENUITEM "&About", IDM_ABOUT_MON
  END
END

// Keyboard Accelerators
IDC_CRYOCALC ACCELERATORS
BEGIN
    //VK_F1,     IDM_HELPEX, VIRTKEY, NOINVERT       // "F1" key
    "?",       IDM_ABOUT, ASCII,   ALT             // "?" key
    VK_OEM_2,  IDM_ABOUT, VIRTKEY, ALT             // "/" key
    0x57,      IDM_CLEAR, VIRTKEY, CONTROL         // Ctrl+W
    0x51,      IDM_EXIT,  VIRTKEY, CONTROL         // Ctrl+Q
    VK_ESCAPE, IDM_EXIT,  VIRTKEY, NOINVERT        // Esc key
    0x52,      IDM_RUN,   VIRTKEY, CONTROL         // Win+R
END

// About Dialog Box
// Everything is RES, X, Y, Width, Height, Style
IDD_ABOUTBOX DIALOGEX 0, 0, 132, 56
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ABOUT_TITLE
FONT 8, "MS Shell Dlg 2"
BEGIN
    ICON            IDI_SMALL, IDC_STATIC, 8, 8, 32, 32, SS_ICON
    LTEXT           ABOUT_CONTENT, IDC_STATIC, 38, 10, 116, 8, SS_NOPREFIX
    LTEXT           ABOUT_COPYRIGHT, IDC_STATIC, 38, 20, 116, 8
    DEFPUSHBUTTON   "OK", IDOK, 50, 35, 40, 14, WS_TABSTOP
END

// Dialog DESIGNINFO
#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN,   21
        RIGHTMARGIN,  132
        TOPMARGIN,    12
        BOTTOMMARGIN, 56
    END
END
#endif

#endif

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MAJOR_VERSION, MINOR_VERSION, BUILD_VERSION
 PRODUCTVERSION MAJOR_VERSION, MINOR_VERSION, BUILD_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG // 0x00000010L
#else // Release mode
 FILEFLAGS 0x00000000L // Release build
#endif  // _DEBUG
 FILEOS VOS_NT_WINDOWS32 // Win32 (Windows NT and later)
 FILETYPE VFT_APP // 0x00000001L
 FILESUBTYPE VFT2_UNKNOWN // 0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // 0x0409 = US English, 0x04B0 = Unicode (1200)
        BEGIN
            VALUE "Comments", "https://github.com/Alex313031/cryocalc"
            VALUE "CompanyName", "Alex313031"
            VALUE "FileDescription", "Win32 Temperature Unit Converter"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "cryocalc"
            VALUE "LegalCopyright", LEGAL_COPYRIGHT
            VALUE "LegalTrademarks", "BSD-3"
            VALUE "OriginalFilename", "cryocalc.exe"
            VALUE "ProductName", "CryoCalc"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
